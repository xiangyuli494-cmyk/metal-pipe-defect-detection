# 数据库配置模板（请勿直接提交带真实密码的 .env）

# 数据库类型：mysql 或 supabase
DB_TYPE=mysql

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=metal_defect_detection
MYSQL_USER=root
MYSQL_PASSWORD=请改成你的密码

# ---------- Supabase（可选，DB_TYPE=supabase 时生效） ----------
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------- AI 模型 ----------
# 不写则默认扫描 backend/models/ 目录下的 .pt
MODEL_PATH=
MODEL_NAME=金属内壁缺陷检测模型

# ---------- 推理参数 ----------
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# ---------- JWT ----------
JWT_SECRET_KEY=请改成一段随机字符串

# ---------- 文件存储 ----------
MAX_UPLOAD_MB=10
UPLOAD_DIR=uploads